# Podman Containerfile for JKCBase/app-gateway (Java 17 Spring Cloud Gateway)
FROM docker.io/library/maven:3.9.9-eclipse-temurin-17-alpine AS build
WORKDIR /workspace
COPY pom.xml .
COPY src ./src
RUN mvn clean package -DskipTests

FROM docker.io/library/eclipse-temurin:17-jre-alpine
WORKDIR /app
COPY --from=build /workspace/target/app-gateway-1.0.0.jar /app/app-gateway.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app-gateway.jar"]
